{
  "datasets": [
    {
      "name": "d9f83421",
      "displayName": "User Activity Aggregates",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  retail_rocket.serving.user_activity_aggregates\n",
        "WHERE\n",
        "  window_start >= current_date() - INTERVAL 1 DAY"
      ],
      "columns": [
        {
          "displayName": "window_start_vn",
          "description": "window_start converted to Vietnam timezone (UTC+7)",
          "expression": "DATEADD(HOUR, 7, `window_start`)"
        },
        {
          "displayName": "window_end_vn",
          "description": "window_end converted to Vietnam timezone (UTC+7)",
          "expression": "DATEADD(HOUR, 7, `window_end`)"
        }
      ]
    },
